generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 Int          @id @default(autoincrement())
  name               String
  email              String       @unique
  password           String
  role               String
  address            String?
  phone              String?
  photo              String?
  discipuladorId     Int?
  obreiroId          Int?
  pastorId           Int?
  leaderId           Int?
  tenantSubdomain    String
  reportDiscip       CellReport[] @relation("DisciplerReports")
  reportLider        CellReport[] @relation("LeaderReports")
  reportPastor       CellReport[] @relation("PastorReports")
  reportWorker       CellReport[] @relation("WorkerReports")
  discipulador       User?        @relation("DiscipuladorToLider", fields: [discipuladorId], references: [id])
  lideres            User[]       @relation("DiscipuladorToLider")
  obreiro            User?        @relation("ObreiroToDiscipulador", fields: [obreiroId], references: [id])
  redeDiscipuladores User[]       @relation("ObreiroToDiscipulador")
  pastor             User?        @relation("PastorToObreiro", fields: [pastorId], references: [id])
  redeObreiros       User[]       @relation("PastorToObreiro")
  cells              Cell[]       @relation("LeaderCells")

  isOnline  Boolean  @default(false)
  celulasDiscipler Cell[] @relation("DisciplerCells")

  celulasPastor Cell[] @relation("PastorCells")

  Cell Cell[] @relation("WorkerCells")

  enrollments Enrollment[]
  enrollmentsAsLeader       Enrollment[] @relation("Leader")
  enrollmentsAsDiscipulador Enrollment[] @relation("Discipulador")
  enrollmentsAsObreiro      Enrollment[] @relation("Obreiro")
  enrollmentsAsPastor       Enrollment[] @relation("Pastor")

  Child Child[]
}

model Cell {
  id            Int       @id @default(autoincrement())
  name          String
  address       String
  latitude      Float?
  longitude     Float?
  schedule      String?
  whatsapp      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  leaderId      Int
  disciplerId   Int
  obreiroId     Int
  pastorId      Int
  attendees     Int       @default(0)
  members       Int       @default(0)
  visitors      Int       @default(0)
  discipler     User      @relation("DisciplerCells", fields: [disciplerId], references: [id])
  leader        User      @relation("LeaderCells", fields: [leaderId], references: [id])
  pastor        User      @relation("PastorCells", fields: [pastorId], references: [id])
  obreiro       User      @relation("WorkerCells", fields: [obreiroId], references: [id])
  reports       CellReport[]
}

model CellReport {
  id                 Int       @id @default(autoincrement())
  meetingDate        DateTime
  membersPresent     Int[]
  attendees          Int[]
  visitors           Int
  additionalInfo     String?
  cellName           String?
  multiplicationDate DateTime?
  cellPhase          String?
  leaderId           Int
  disciplerId        Int
  pastorId           Int
  workerId           Int
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  discipler          User      @relation("DisciplerReports", fields: [disciplerId], references: [id])
  leader             User      @relation("LeaderReports", fields: [leaderId], references: [id])
  pastor             User      @relation("PastorReports", fields: [pastorId], references: [id])
  obreiro            User      @relation("WorkerReports", fields: [workerId], references: [id])

  Cell Cell[]
}

model Event {
  id           String   @id @default(cuid())
  name         String
  description  String
  image        String?
  startDate    DateTime
  endDate      DateTime
  formUrl     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  registration Registration[]
}

model Registration {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id])
  userId    String   // ID do usuário logado
  answers   Json     // Respostas para o formulário
  createdAt DateTime @default(now())
}

// schema.prisma
model Notification {
  id        String   @id @default(uuid()) // ID único gerado automaticamente
  userId    Int?   // ID do usuário associado à notificação
  title     String   // Título da notificação
  message   String   // Mensagem da notificação
  read      Boolean  @default(false) // Status de leitura da notificação
  createdAt DateTime @default(now()) // Data de criação da notificação
}

model Child {
  id        Int    @id @default(autoincrement())
  name      String
  age       Int
  room      String
  parentId  Int
  parent    User   @relation(fields: [parentId], references: [id])
  status    String @default("ativo") // "ativo" ou "retirada"
}


model Arquivos {
  id       Int      @id @default(autoincrement())
  fileName String   @unique
  titulo   String
  dataCulto DateTime
  fileUrl  String
}

model Course {
  id    String   @id @default(uuid())
  name  String   @unique
  description String
  enrollments Enrollment[]
}

model Enrollment {
  id             String   @id @default(uuid())
  courseId       String
  name           String
  email          String
  phone          String?
  address        String?
  leaderId       Int?
  discipuladorId Int?
  obreiroId      Int?
  pastorId       Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  course         Course   @relation(fields: [courseId], references: [id])
  leader         User?    @relation("Leader", fields: [leaderId], references: [id])
  discipulador   User?    @relation("Discipulador", fields: [discipuladorId], references: [id])
  obreiro        User?    @relation("Obreiro", fields: [obreiroId], references: [id])
  pastor         User?    @relation("Pastor", fields: [pastorId], references: [id])

  User User[]
}

