generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 Int          @id @default(autoincrement())
  name               String
  email              String       @unique
  password           String
  role               String
  address            String?
  phone              String?
  photo              String?
  discipuladorId     Int?
  obreiroId          Int?
  pastorId           Int?
  leaderId           Int?
  reportDiscip       CellReport[] @relation("DisciplerReports")
  reportLider        CellReport[] @relation("LeaderReports")
  reportPastor       CellReport[] @relation("PastorReports")
  reportWorker       CellReport[] @relation("WorkerReports")
  discipulador       User?        @relation("DiscipuladorToLider", fields: [discipuladorId], references: [id])
  lideres            User[]       @relation("DiscipuladorToLider")
  obreiro            User?        @relation("ObreiroToDiscipulador", fields: [obreiroId], references: [id])
  redeDiscipuladores User[]       @relation("ObreiroToDiscipulador")
  pastor             User?        @relation("PastorToObreiro", fields: [pastorId], references: [id])
  redeObreiros       User[]       @relation("PastorToObreiro")
  cells              Cell[]       @relation("LeaderCells")

  celulasDiscipler Cell[] @relation("DisciplerCells")

  celulasPastor Cell[] @relation("PastorCells")

  Cell Cell[] @relation("WorkerCells")
}

model Cell {
  id            Int       @id @default(autoincrement())
  name          String
  address       String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  leaderId      Int
  disciplerId   Int
  obreiroId     Int
  pastorId      Int
  attendees     Int       @default(0)
  members       Int       @default(0)
  discipler     User      @relation("DisciplerCells", fields: [disciplerId], references: [id])
  leader        User      @relation("LeaderCells", fields: [leaderId], references: [id])
  pastor        User      @relation("PastorCells", fields: [pastorId], references: [id])
  obreiro       User      @relation("WorkerCells", fields: [obreiroId], references: [id])
  reports       CellReport[]
}

model CellReport {
  id                 Int       @id @default(autoincrement())
  meetingDate        DateTime
  membersPresent     Int
  attendees          Int
  visitors           Int
  additionalInfo     String?
  cellName           String?
  multiplicationDate DateTime?
  cellPhase          String?
  leaderId           Int
  disciplerId        Int
  pastorId           Int
  workerId           Int
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  discipler          User      @relation("DisciplerReports", fields: [disciplerId], references: [id])
  leader             User      @relation("LeaderReports", fields: [leaderId], references: [id])
  pastor             User      @relation("PastorReports", fields: [pastorId], references: [id])
  obreiro            User      @relation("WorkerReports", fields: [workerId], references: [id])

  Cell Cell[]
}

model Event {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  date        DateTime
  time        DateTime
  location    String
}
